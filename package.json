{
  "name": "youtube-channel-scraper",
  "version": "1.0.0",
  "description": "Scrape public YouTube channel stats and latest-video summaries from URLs, handles, or search keywords.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsx src/main.ts",
    "start:compiled": "node dist/main.js",
    "build": "tsc",
    "test": "npm run build && node scripts/audit.mjs",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "youtube",
    "scraper",
    "apify",
    "analytics",
    "channel",
    "video"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "apify": "^3.1.0",
    "crawlee": "^3.11.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "ip-address": "10.5.0",
    "nanoid": "3.3.18"
  }
}
